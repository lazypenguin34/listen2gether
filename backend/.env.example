# Port the Express/Socket.IO server listens on.
PORT=8888

# Runtime environment. Set to "production" in deployment; enables
# production-only behavior such as the default FRONTEND_URL below.
NODE_ENV=development

# Origin allowed to make cross-origin requests to this backend (the deployed
# frontend's URL). Falls back to the Azure Static Web Apps URL in production
# or http://localhost:5173 in development if unset.
FRONTEND_URL=http://localhost:5173

# Bearer token required to authenticate against the admin API. Generate one
# with: openssl rand -hex 32
ADMIN_TOKEN=changeme_generate_with_openssl_rand_hex_32
